# Apache Configuration for PNMEC (web_cty)

# Prevent directory browsing
Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # Block direct HTTP access to private directories
    RewriteRule ^(database|config|storage)/ - [F,L,NC]
</IfModule>

# Security Headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# Block access to private and sensitive file extensions
<FilesMatch "(?i:\.(sql|env|ini|log|bak|old|dist|sh|md|git.*))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
