# Prevent directory indexing
Options -Indexes

# Disable PHP script execution inside upload directory
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<IfModule mod_php8.c>
    php_flag engine off
</IfModule>

# Block execution or serving of executable scripts
<FilesMatch "(?i:\.(php|phtml|php3|php4|php5|php7|php8|phar|cgi|pl|py|sh|bash))$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order allow,deny
        Deny from all
    </IfModule>
</FilesMatch>
